# ============================================
# Shortsyt — .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Virtual environments
venv*/
.venv/

# IDE
.idea/
.vscode/
*.swp

# ============================================
# SECRETS & TOKENS — NEVER COMMIT THESE
# ============================================
accounts/
client_secret.json
*.pickle
token*.pickle
cookies.txt
.env

# ============================================
# GENERATED MEDIA — too large for git
# ============================================
temp_videos/
videos/
music/
thumbnails/
*.mp4
*.mp3
*.wav
*.avi
*.mkv
*.gif
*.jpg
*.jpeg
*.png
!shortsyt-desktop/public/*.png
!shortsyt-desktop/src/assets/*.png

# Node / Desktop / Mobile
node_modules/
dist-app/
dist-electron/
dist-installer/
*.exe
*.blockmap
*.7z
shortsyt-desktop/node_modules/
shortsyt-desktop/dist/
shortsyt-desktop/dist-app/
shortsyt-desktop/dist-electron/
shortsyt-desktop/dist-installer/
shortsyt-desktop/release/
shortsyt-app/
data/

# ML models
*.pkl
*.h5
*.pt
*.pth

# Logs & Debug
*.log
logs/
.last_track
lol_agent/lol_music/.last_track
scratch/
lol_agent/debug_*/
lol_agent/debug_frames/
lol_agent/debug_jinx/
lol_agent/debug_last_frag/
lol_agent/lol_temp/
lol_agent/clip_scan.txt
lol_agent/debug_ocr.txt

