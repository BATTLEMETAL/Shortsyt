# ============================================
# Shortsyt — .gitignore (Production Security & Hygiene)
# ============================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv*/
.venv/
env/

# IDE & OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# SECRETS, TOKENS & SENSITIVE CREDENTIALS — NEVER COMMIT
# ============================================
accounts/
client_secret*.json
*.pickle
token*.pickle
cookies.txt
.env
.env.*
*.key
*.pem
token*.json
auth_url.txt
*auth_url*.txt

# ============================================
# PERSONAL RESUME & INSTALLER BINARIES
# ============================================
*CV*
*Curriculum*
*.pdf
*.exe
*.blockmap
*.7z

# ============================================
# NODE / ELECTRON / MOBILE BUILDS
# ============================================
node_modules/
*/node_modules/
dist-app/
dist-electron/
dist-installer/
*/dist-installer/
shortsyt-desktop/dist/
shortsyt-desktop/dist-app/
shortsyt-desktop/dist-electron/
shortsyt-desktop/dist-installer/
shortsyt-desktop/release/
shortsyt-app/node_modules/
shortsyt-app/.expo/
shortsyt-app/android/
shortsyt-app/ios/

# ============================================
