{
  "name": "shortsyt-desktop",
  "version": "1.0.0",
  "description": "Shortsyt Desktop Application - League of Legends Shorts Automation",
  "author": "Michał Zalewski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BATTLEMETAL/Shortsyt.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -r \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "tsc && vite build",
    "build": "npm run build:vite",
    "dist": "npm run build:vite && electron-builder --win",
    "dist:dir": "npm run build:vite && electron-builder --win --dir",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.shortsyt.desktop",
    "productName": "Shortsyt Studio",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^8.0.0"
  }
}
