# Shortsyt — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# ─── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Synapsa Local LLM Bridge (optional — only needed for local AI mode) ───────
# Path to Synapsa venv Python executable
SYNAPSA_PYTHON=C:\path\to\Synapsa\venv\Scripts\python.exe

# Path to Synapsa project root
SYNAPSA_ROOT=C:\path\to\Synapsa

# Path to the project Synapsa should analyze (defaults to shortsyt root)
SYNAPSA_TARGET_PROJECT=C:\path\to\shortsyt

# ─── CORS (for API mode) ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8501

# ─── Shortsyt API Server ────────────────────────────────────────────────────────
# Hasło do logowania w apce Android (zmień na własne!)
API_PASSWORD=shortsyt2026

# JWT secret — wygeneruj losowy string 32+ znaków
JWT_SECRET=change_me_to_random_32char_secret_here

# Port serwera FastAPI
API_PORT=8765

# Folder z surowymi klipami (LOL_INPUT_DIR)
LOL_INPUT_DIR=C:\Medal\Edits

# Folder wyjściowy dla gotowych Shortów
LOL_OUTPUT_DIR=C:\Users\mz100\Videos\lol_shorts_output
